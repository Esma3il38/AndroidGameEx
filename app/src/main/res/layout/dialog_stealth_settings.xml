<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/circle_background"
    android:backgroundTint="#2C2C2C"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stealth Settings"
        android:textColor="@color/primary_hacker_green"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <CheckBox
        android:id="@+id/cb_hide_from_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hide from Game"
        android:textColor="#FFFFFF"
        android:buttonTint="@color/primary_hacker_green"/>

    <CheckBox
        android:id="@+id/cb_randomize_pkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Randomize Package"
        android:textColor="#FFFFFF"
        android:buttonTint="@color/primary_hacker_green"/>

    <CheckBox
        android:id="@+id/cb_virtual_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use Root in Virtual Space"
        android:textColor="#FFFFFF"
        android:buttonTint="@color/primary_hacker_green"/>

    <Button
        android:id="@+id/btn_apply_stealth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apply"
        android:backgroundTint="@color/primary_hacker_green"
        android:textColor="#000000"
        android:layout_marginTop="16dp"/>

</LinearLayout>
