<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <EditText
        android:id="@+id/et_script_input"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#2C2C2C"
        android:gravity="top|start"
        android:hint="gg.searchNumber('100', gg.TYPE_DWORD)..."
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#88FFFFFF"
        android:fontFamily="monospace"
        android:textSize="12sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_execute_script"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Execute"
            android:backgroundTint="@color/primary_hacker_green"
            android:textColor="#000000"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_disassemble"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disasm"
            android:backgroundTint="#FF9800"
            android:textColor="#000000"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_assemble"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Asm"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_script_output"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Output:"
        android:textColor="#AAAAAA"
        android:fontFamily="monospace"
        android:layout_marginTop="8dp"/>

</LinearLayout>
