<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goto:"
            android:textColor="@color/primary_hacker_green"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/et_goto_address"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/tab_indicator_active"
            android:padding="4dp"
            android:textColor="#FFFFFF"
            android:hint="0x00000000"
            android:textColorHint="#88FFFFFF"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:inputType="textNoSuggestions"/>

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#000000">

        <TextView
            android:id="@+id/tv_hex_dump"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00000000: 00 00 00 00 00 00 00 00  ........\n00000010: FF FF FF FF 00 00 00 00  ........"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:padding="8dp"/>

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_trace_offset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trace Offset"
            android:backgroundTint="#FF9800"
            android:textColor="#000000"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_hook"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hook func"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loaded Modules:"
        android:textColor="@color/primary_hacker_green"
        android:layout_marginTop="8dp"
        android:textStyle="bold"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_modules_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:background="#1E1E1E"
        android:padding="4dp"/>

</LinearLayout>
